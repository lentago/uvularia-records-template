{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lentago.github.io/uvularia/core/schema/record.schema.json",
  "title": "Record frontmatter",
  "description": "The whole machine-readable surface of one vault record. Prose is for people; this is for machines. No field outside this schema is permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "visibility", "effective", "certainty", "subjects", "tags"],
  "properties": {
    "id": { "$ref": "#/$defs/record_id" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["minutes", "notice", "agenda", "policy", "bylaw", "filing", "report", "announcement", "faq"] },
    "status": { "enum": ["draft", "approved", "superseded", "retracted"] },
    "visibility": { "const": "public" },
    "effective": { "$ref": "#/$defs/iso_date" },
    "approved": { "$ref": "#/$defs/iso_date" },
    "source": { "$ref": "#/$defs/source" },
    "certainty": { "enum": ["verified", "reported"] },
    "supersedes": { "$ref": "#/$defs/record_id" },
    "subjects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "corrections": { "type": "array", "items": { "$ref": "#/$defs/correction" } },
    "publish_at": { "$ref": "#/$defs/iso_datetime" }
  },
  "allOf": [
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "approved" } } },
      "then": { "required": ["source", "approved"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "announcement" } } },
      "then": { "required": ["publish_at"] }
    }
  ],
  "$defs": {
    "record_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "iso_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "iso_datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})?)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "sha256"],
      "properties": {
        "kind": { "enum": ["pdf", "url", "html", "text", "scan", "image", "other"] },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "note"],
      "properties": {
        "date": { "$ref": "#/$defs/iso_date" },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
