{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lentago.github.io/uvularia/core/schema/bundle.schema.json",
  "title": "Corpus bundle",
  "description": "The published corpus artifact every consumer reads by URL and digest. One entry per published record, in mitchella's wiki-loader entry shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest",
    "published_at",
    "records"
  ],
  "properties": {
    "digest": {
      "$ref": "#/$defs/sha256"
    },
    "published_at": {
      "$ref": "#/$defs/iso_datetime"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "iso_datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})?)?$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "title",
        "tags",
        "volatility",
        "body",
        "path",
        "certainty",
        "archived"
      ],
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "volatility": {
          "enum": [
            "stable",
            "live"
          ],
          "description": "mitchella's vocabulary: stable (facts that change only by a new record) or live (state that can change between publishes). Vault records are always stable; live entries come from signals, not from the vault."
        },
        "body": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "certainty": {
          "enum": [
            "verified",
            "inferred",
            "unknown"
          ],
          "description": "mitchella's vocabulary. The bundle builder maps a record's certainty: verified \u2192 verified, reported \u2192 inferred; anything missing \u2192 unknown."
        },
        "archived": {
          "type": "boolean"
        }
      }
    }
  }
}
